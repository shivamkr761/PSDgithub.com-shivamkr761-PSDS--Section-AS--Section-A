# Node class
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


# Stack class
class Stack:
    def __init__(self):
        self.top = None

    # Push operation
    def push(self, data):
        new_node = Node(data)
        new_node.next = self.top
        self.top = new_node
        print(data, "pushed into stack")

    # Pop operation
    def pop(self):
        if self.top is None:
            print("Stack Underflow")
            return

        data = self.top.data
        self.top = self.top.next
        print(data, "popped from stack")

    # Display stack
    def display(self):
        if self.top is None:
            print("Stack is empty")
            return

        temp = self.top
        print("Stack:", end=" ")

        while temp:
            print(temp.data, end=" ")
            temp = temp.next

        print()


# Main program
stack = Stack()

stack.push(10)
stack.push(20)
stack.push(30)

stack.display()

stack.pop()
stack.display()

stack.pop()
stack.display()